NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://iptirs_app:CHANGE_ME@localhost:5432/iptirs_dev
DATABASE_SSL=false
OIDC_ISSUER=https://identity.example.invalid/
OIDC_AUDIENCE=iptirs-api
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=120

# Evidence storage is disabled until a private bucket and scanner are provisioned.
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_CLAMAV_HOST=
EVIDENCE_CLAMAV_PORT=3310
